{
  "name": "parenteacher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "parents": "npm run dev --prefix parents-dashboard",
    "teachers": "npm run dev --prefix teachers-dashboard",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run parents\" \"npm run teachers\"",
    "build:parents": "npm run build --prefix parents-dashboard",
    "build:teachers": "npm run build --prefix teachers-dashboard",
    "build": "npm run build:parents && npm run build:teachers"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
